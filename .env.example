# ==========================================
# APPLICATION
# ==========================================

APP_NAME=Intelligent Bug Diagnosis Platform
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# ==========================================
# DATABASE — PostgreSQL + pgvector
# ==========================================

POSTGRES_DB=bugdiag
POSTGRES_USER=bugdiag
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://bugdiag:replace-with-a-strong-local-password@localhost:5432/bugdiag

# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=replace-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=http://localhost:5173

# ==========================================
# FILE UPLOADS
# ==========================================

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.txt,.log,.json,.md,.csv

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
