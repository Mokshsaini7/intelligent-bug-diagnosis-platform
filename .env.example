DATABASE_URL=postgresql://bugdiag:bugdiag@localhost:5432/bugdiag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_BYTES=1048576
SEARCH_TOP_K=8
MIN_COSINE_SIMILARITY=0.20
MOZILLA_BUGZILLA_URL=https://bugzilla.mozilla.org
ECLIPSE_BUGZILLA_URL=https://bugs.eclipse.org/bugs
APACHE_JIRA_URL=https://issues.apache.org/jira
APACHE_JIRA_JQL=project in (LUCENE,HADOOP,SPARK) AND resolution is not EMPTY ORDER BY updated DESC
